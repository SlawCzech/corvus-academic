// Deploy pipeline for the two-service topology.
//
// CI (tests, lint, types) runs in GitHub Actions; Jenkins only ships what
// already passed. Images are built from the repo on the deployment host
// rather than pulled from a registry — there is no registry yet, and the
// choice of one is deliberately still open.

pipeline {
    agent any

    environment {
        COMPOSE  = 'docker compose -f infra/docker-compose.yml'
        ENV_FILE = credentials('corvus-env-production')
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                // The compose files read ../.env; production values come from
                // Jenkins credentials, never from the repository.
                sh 'cp "$ENV_FILE" .env'
            }
        }

        stage('Build images') {
            steps {
                sh "${COMPOSE} build app agent frontend postgres"
            }
        }

        stage('Migrate') {
            // Migrations run before the new containers serve traffic: both
            // app lineages and the agent's own.
            steps {
                sh "${COMPOSE} run --rm app alembic -c alembic_identity.ini upgrade head"
                sh "${COMPOSE} run --rm app alembic -c alembic_mentoring.ini upgrade head"
                sh "${COMPOSE} run --rm agent alembic upgrade head"
            }
        }

        stage('Deploy') {
            steps {
                sh "${COMPOSE} up -d --remove-orphans"
            }
        }

        stage('Healthcheck') {
            steps {
                // `app` reports the agent's health too, so one probe covers
                // the pair.
                sh '''
                    for i in $(seq 1 30); do
                        if curl -fsS http://localhost:8000/health | grep -q '"status":"ok"'; then
                            echo "healthy"
                            exit 0
                        fi
                        sleep 5
                    done
                    echo "app did not become healthy"
                    exit 1
                '''
            }
        }
    }

    post {
        always {
            // The file holds production secrets; it does not outlive the build.
            sh 'rm -f .env'
        }
        failure {
            echo 'Deploy failed — previous containers are still running.'
        }
    }
}
