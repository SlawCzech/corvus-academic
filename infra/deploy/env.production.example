# /srv/corvus/.env on the server — never in git, never on a laptop.
# Generate every secret on the server (commands below), then copy FERNET_KEY
# and POSTGRES_PASSWORD into a password manager: without FERNET_KEY a restored
# backup cannot decrypt the promoters' API keys.

CORVUS_DOMAIN=corvus.saek.dev

# The four secrets below are filled in by the one-liner in docs/deploy.md
# (openssl; FERNET_KEY is 32 random bytes in url-safe base64, as Fernet wants).
POSTGRES_PASSWORD=
JWT_SECRET=
FERNET_KEY=

# The first admin, created on the first start. Admins manage accounts and
# guidelines; they do not hold students (ADR 0008).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Half an hour, as in development: how long a deleted user keeps access. The
# refresh token renews it unseen, so a review may outlast it.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Crossref's "polite pool" for the bibliography check — a contact address.
CROSSREF_MAILTO=

MAX_UPLOAD_BYTES=26214400
RETENTION_SWEEP_INTERVAL_HOURS=24

# --- backups (infra/deploy/backup.sh) ---------------------------------------
# rclone remote and path the encrypted dumps are copied to, e.g. r2:corvus-backups
BACKUP_REMOTE=
# Days of dumps kept on the server itself (the remote keeps its own).
BACKUP_KEEP_DAYS=14
# A healthchecks.io (or similar) URL pinged after every good backup, which
# mails you when a day passes without one.
BACKUP_PING_URL=

# --- monitoring (infra/deploy/watch.sh, every 5 min) ------------------------
# A second healthchecks.io check, period 5 min, grace 10 min. Pinged when all
# is well, sent /fail with the findings when it is not; silence means the
# server or cron is down.
WATCH_PING_URL=
