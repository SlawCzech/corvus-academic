# Model backend
MODEL_BACKEND=ollama                     # ollama | claude | openai
OLLAMA_MODEL=qwen3:30b-a3b
OLLAMA_BASE_URL=http://ollama:11434

# Claude API (only needed when MODEL_BACKEND=claude)
ANTHROPIC_API_KEY=                       # fill in locally

# LangSmith tracing (optional — set to true and add key to enable)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=                       # https://smith.langchain.com — required only when LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=corvus

# Databases
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://user:pass@postgres:5432/thesis_reviewer

# Security
FERNET_KEY=                              # generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET=                              # random string, min 32 chars
