# Deployment environment — local | production
# Drives cookie Secure flag (off locally so plain-HTTP dev works), log level, defaults.
ENVIRONMENT=local

# Model backend
MODEL_BACKEND=ollama                     # ollama | claude | openai
OLLAMA_MODEL=qwen3:30b-a3b               # alternatives available
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Claude API (only needed when MODEL_BACKEND=claude)
ANTHROPIC_API_KEY=                       # fill in locally

# LangSmith tracing (optional — set to true and add key to enable)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=                       # https://smith.langchain.com — required only when LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=corvus

# Databases
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+asyncpg://user:pass@postgres:5432/thesis_reviewer

# Security
FERNET_KEY=  # generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET=                                   # random string, min 32 chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Admin seed — REQUIRED. ADMIN_PASSWORD must be at least 12 characters.
# Set these before running `docker compose up` for the first time.
ADMIN_EMAIL=
ADMIN_PASSWORD=                          # REQUIRED: min 12 chars, e.g. generate with: openssl rand -base64 16

# Service discovery (internal docker network)
AGENT_URL=http://agent:8002
