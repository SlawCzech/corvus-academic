# Deployment environment — local | production
# Drives cookie Secure flag (off locally so plain-HTTP dev works), log level, defaults.
ENVIRONMENT=local

# Modele: każda akcja idzie na klucz promotora (Claude albo OpenAI), zapisany
# w jego profilu. Serwer nie ma własnego modelu ani klucza (ADR 0022).
ANTHROPIC_EFFORT=medium                  # low | medium | high | xhigh | max — ile Claude myśli przed odpowiedzią (czas i koszt)

# Langfuse tracing, self-hosted (optional): `make langfuse-up`, then uncomment.
# The keys are the project keys Langfuse creates on first start — keep them in
# sync with infra/langfuse/docker-compose.yml. UI: http://localhost:3100
# LANGFUSE_BASE_URL=http://host.docker.internal:3100
# LANGFUSE_PUBLIC_KEY=pk-lf-corvus-local
# LANGFUSE_SECRET_KEY=sk-lf-corvus-local

# Crossref (weryfikacja bibliografii). Bez adresu: 1 zapytanie na sekundę; z adresem
# zapytania idą do „polite pool” z wyższym limitem. Do Crossref trafiają tylko opisy
# bibliograficzne i ten adres — nigdy tekst pracy.
CROSSREF_MAILTO=                         # adres kontaktowy osoby prowadzącej instancję

# LangSmith tracing (optional — set to true and add key to enable). Prompts
# carry thesis text: use it only with synthetic theses, never real students'.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=                       # https://smith.langchain.com — required only when LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=corvus

# Databases
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+asyncpg://user:pass@postgres:5432/thesis_reviewer

# Security
FERNET_KEY=  # generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET=                                   # random string, min 32 chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Admin seed — REQUIRED. ADMIN_PASSWORD must be at least 12 characters.
# Set these before running `docker compose up` for the first time.
ADMIN_EMAIL=
ADMIN_PASSWORD=                          # REQUIRED: min 12 chars, e.g. generate with: openssl rand -base64 16

# Thesis files (ADR 0006). Largest accepted upload, and how often app purges
# versions under retention (0 = only when `make purge-drafts` is run).
MAX_UPLOAD_BYTES=26214400
RETENTION_SWEEP_INTERVAL_HOURS=24

# Service discovery (internal docker network)
AGENT_URL=http://agent:8002

# Frontend → app (the only service the browser layer talks to)
APP_URL=http://app:8000
